{
  "name": "silent-lab-dual-from-scratch",
  "private": true,
  "type": "module",
  "workspaces": ["apps/tech", "apps/engineering"],
  "scripts": {
    "install:all": "npm install",
    "dev:tech": "npm --prefix apps/tech run dev -- --host 127.0.0.1 --port 5173",
    "dev:engineering": "npm --prefix apps/engineering run dev -- --host 127.0.0.1 --port 5174",
    "dev:both": "concurrently -k -n TECH,ENGINEERING -c cyan,yellow \"npm run dev:tech\" \"npm run dev:engineering\"",
    "check:all": "npm run check --workspaces --if-present",
    "lint:all": "npm run lint --workspaces --if-present",
    "test:all": "npm run test --workspaces --if-present",
    "build:all": "npm run build --workspaces --if-present",
    "verify:all": "node scripts/verify-all.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "capture:all": "node scripts/capture-all.mjs",
    "funnel:verify": "node scripts/funnel-review.mjs",
    "reviews:legacy:build": "node scripts/build-review-evidence.mjs",
    "reviews:tech-v2:capture": "node scripts/tech-v2-capture.mjs",
    "comparison:build": "node scripts/build-comparison.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "concurrently": "^9.2.1",
    "sharp": "^0.35.3"
  }
}
