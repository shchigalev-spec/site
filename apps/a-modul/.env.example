# Server-only lead integration. Never expose these values through PUBLIC_* variables.
A_MODUL_LEAD_WEBHOOK_URL=
A_MODUL_LEAD_WEBHOOK_TOKEN=
A_MODUL_CRM_MODE=webhook

# Adapter-node rejects request bodies above this boundary before application form parsing.
# Keep this at or above the documented 40 MB total attachment allowance plus multipart overhead.
BODY_SIZE_LIMIT=45M

# Required by adapter-node when requests are served directly at this public origin.
ORIGIN=https://a-modul.ru
# Behind a trusted reverse proxy, configure the adapter-node forwarded-header variables instead:
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
# ADDRESS_HEADER=x-forwarded-for

# Public runtime configuration.
PUBLIC_YANDEX_METRICA_ID=
PUBLIC_SITE_URL=https://a-modul.ru
PUBLIC_SITE_PHONE=88003336131
PUBLIC_SITE_EMAIL=zakaz@a-modul.ru
PUBLIC_CALLTRACKING_SCRIPT_URL=
